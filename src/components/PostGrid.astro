---
// /blog 와 /blog/category/* 가 함께 쓰는 카드 목록.
// 두 곳에 같은 마크업을 복사해두면 한쪽만 고치는 사고가 난다.
import { Image } from 'astro:assets';
import { CATEGORY_LABELS } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Seoul' });
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="post-card">
          <div class="meta">
            <span class="chip">{post.data.category ? CATEGORY_LABELS[post.data.category] : post.data.service}</span>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.cover && (
            <Image
              src={post.data.cover}
              alt={post.data.coverAlt ?? ''}
              width={720}
              densities={[1, 2]}
              class="thumb"
            />
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list{list-style:none;display:grid;grid-template-columns:1fr;gap:28px}
  @media(min-width:768px){
    .post-list{grid-template-columns:1fr 1fr;gap:24px}
    .post-card{display:flex;flex-direction:column}
    .post-card p{flex:1}
    .thumb{width:100%;height:220px;object-fit:cover}
  }
  .post-card{display:block;border:2px solid var(--border);border-radius:var(--radius);padding:24px;transition:border-color .15s}
  .post-card:hover{border-color:var(--primary)}
  .thumb{margin-top:16px}
  .meta{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted);margin-bottom:8px}
  .chip{background:var(--primary-light);color:var(--primary-dark);border:1px solid #bbf7d0;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:capitalize}
  .post-card h2{font-size:20px;font-weight:800;margin-bottom:6px}
  .post-card p{color:var(--muted);font-size:15px}
</style>
