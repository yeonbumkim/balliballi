---
// 카테고리 필터 바. 카드 안의 칩은 <a> 안에 <a>가 되어 링크로 못 만든다 —
// 그래서 필터는 목록 위에 따로 둔다.
import { getCollection } from 'astro:content';
import { CATEGORY_LABELS } from '../consts';

interface Props {
  active?: keyof typeof CATEGORY_LABELS | null;
}
const { active = null } = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) {
  if (p.data.category) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
}

// 글이 실제로 있는 카테고리만 노출한다 (빈 카테고리로 보내면 막다른 길)
const items = (Object.keys(CATEGORY_LABELS) as (keyof typeof CATEGORY_LABELS)[])
  .filter((slug) => (counts.get(slug) ?? 0) > 0)
  .map((slug) => ({ slug, label: CATEGORY_LABELS[slug], count: counts.get(slug)! }))
  .sort((a, b) => b.count - a.count);
---

<nav class="cat-nav" aria-label="Filter guides by category">
  <a href="/blog/" class:list={['cat', { on: active === null }]} aria-current={active === null ? 'page' : undefined}>
    All <span class="n">{posts.length}</span>
  </a>
  {
    items.map((it) => (
      <a
        href={`/blog/category/${it.slug}/`}
        class:list={['cat', { on: active === it.slug }]}
        aria-current={active === it.slug ? 'page' : undefined}
      >
        {it.label} <span class="n">{it.count}</span>
      </a>
    ))
  }
</nav>

<style>
  .cat-nav{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 32px}
  .cat{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700;color:var(--fg);
       background:#fff;border:2px solid var(--border);border-radius:999px;padding:7px 14px;
       transition:border-color .15s,background .15s}
  .cat:hover{border-color:var(--primary)}
  .cat.on{background:var(--primary);border-color:var(--primary);color:#fff}
  .n{font-weight:600;font-size:12.5px;color:var(--muted)}
  .cat.on .n{color:#e6fffa}
</style>
