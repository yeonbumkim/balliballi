---
import { WHATSAPP_URL } from '../consts';

interface Props {
  title: string;
  description: string;
  ogImage?: string; // absolute URL
  canonical?: string;
  noindex?: boolean;
}
const { title, description, ogImage, canonical, noindex = false } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = ogImage ?? new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7890314542345467"
      crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X5GFEDGW6Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X5GFEDGW6Y');
      gtag('config', 'AW-17808115804');
    </script>

    <title>{title}</title>
    <meta name="naver-site-verification" content="b855ca0b2040ecb261c6e73882c636c6aa57d176" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Balli Balli Seoul" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="logo" aria-label="Balli Balli Seoul home">
          <span class="logo-mark">⚡</span>
          <span>Balli Balli <span class="accent">Seoul</span></span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/about/">About</a>
          <a href="/blog/">Blog</a>
          <a href="/#services">Services</a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="nav-cta">💬 WhatsApp</a>
        </nav>
      </div>
    </header>

    <main class="container page-main">
      <slot />
    </main>

    <!-- Floating mobile CTA bar (matches static pages) -->
    <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="float-cta">💬 WhatsApp — in English</a>

    <!-- WhatsApp click conversion tracking (GA4: whatsapp_click) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
        if (a && window.gtag) {
          gtag('event', 'whatsapp_click', { page_path: location.pathname });
          /* TODO(Google Ads): 전환 액션 생성 후 아래 주석을 해제하고 ID/라벨 교체
          gtag('event', 'conversion', { send_to: 'AW-XXXXXXXXX/CONVERSION_LABEL' }); */
        }
      }, true);
    </script>

    <footer class="site-footer">
      <div class="container">
        <p class="foot-brand"><span class="logo-mark small">⚡</span> Balli Balli Seoul — help for expats &amp; travelers, arranged in English.</p>
        <ul class="foot-links">
          <li><a href="/plumbing">Plumbing</a></li>
          <li><a href="/locksmith">Locksmith</a></li>
          <li><a href="/cleaning">Cleaning</a></li>
          <li><a href="/moving">Moving Help</a></li>
          <li><a href="/etc">Anything Else</a></li>
          <li><a href="/about/">About Us</a></li>
        </ul>
        <div class="notice">
          <p><strong>Service Notice</strong></p>
          <p>Balli Balli Seoul, operated by Jiinus (지인어스), is a coordination and booking service. We connect customers with independent local service providers and are not the party performing on-site work. All work is carried out by the assigned provider, who is responsible for the work performed — including its quality, safety, any warranties, and any damages arising from it. Prices, response times and warranty terms shown on this site are indicative and are fulfilled by the assigned provider; final terms are confirmed with you in the chat before booking.</p>
          <p>지인어스는 통신판매중개자로서 거래의 당사자가 아니며, 시공·서비스의 이행 및 이에 따른 책임은 해당 서비스 제공자(시공자)에게 있습니다.</p>
        </div>
        <p class="copy">© 2026 Balli Balli Seoul (지인어스). Business reg. no. 108-24-44405 · E-commerce reg. no. 2025-서울중구-143</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root{
    --primary:#16a34a; --primary-dark:#15803d; --primary-light:#f0fdf4;
    --fg:#121212; --muted:#6b7280; --border:#e5e7eb; --bg:#ffffff; --bg-soft:#f9fafb;
    --whatsapp:#25d366; --radius:16px;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{font-family:"Pretendard Variable",Pretendard,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--fg);background:var(--bg);line-height:1.7;-webkit-font-smoothing:antialiased}
  img{max-width:100%;height:auto;display:block;border-radius:12px}
  a{color:inherit;text-decoration:none}
  .container{width:100%;max-width:760px;margin:0 auto;padding:0 20px}
  .accent{color:var(--primary)}

  .site-header{position:sticky;top:0;height:64px;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);z-index:50}
  .nav{display:flex;align-items:center;justify-content:space-between;height:64px}
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px}
  .logo-mark{width:36px;height:36px;border-radius:10px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
  .logo-mark.small{width:24px;height:24px;font-size:13px;display:inline-flex;vertical-align:middle;margin-right:6px}
  .nav-links{display:flex;gap:4px;align-items:center}
  .nav-links a{padding:8px 14px;font-size:14px;font-weight:500;color:#374151;border-radius:999px}
  .nav-links a:hover{background:var(--bg-soft);color:var(--fg)}
  .nav-cta{background:var(--whatsapp);color:#fff !important;font-weight:700}
  /* CTA-first mobile: hide nav links except the WhatsApp CTA, same as static pages */
  @media(max-width:820px){.nav-links a:not(.nav-cta){display:none}}

  .page-main{padding:84px 20px 150px}
  @media(max-width:640px){.page-main{padding:56px 20px 110px}}

  .float-cta{position:fixed;bottom:0;left:0;right:0;z-index:40;display:none;align-items:center;justify-content:center;gap:8px;padding:16px;font-weight:800;font-size:15px;background:var(--whatsapp);color:#fff}
  @media(max-width:820px){.float-cta{display:flex}body{padding-bottom:56px}}

  .site-footer{background:var(--bg-soft);border-top:1px solid var(--border);padding:56px 0 64px;font-size:14px;color:var(--muted)}
  .foot-brand{color:var(--fg);font-weight:600;margin-bottom:14px}
  .foot-links{list-style:none;display:flex;flex-wrap:wrap;gap:6px 18px;margin-bottom:22px}
  .foot-links a{text-decoration:underline;text-underline-offset:3px}
  .foot-links a:hover{color:var(--fg)}
  .notice{border-top:1px solid var(--border);padding-top:18px;font-size:12px;line-height:1.7}
  .notice p+p{margin-top:6px}
  .copy{margin-top:18px;font-size:12px}
</style>
