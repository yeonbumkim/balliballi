---
import Base from '../layouts/Base.astro';
import { EMAIL_URL, EMAIL_ADDRESS } from '../consts';
---

<Base
  title="Contact — Services Ended | Balli Balli Seoul"
  description="Balli Balli Seoul stopped taking service enquiries on 11 November 2026. Our KakaoTalk and WhatsApp lines are closed. Email remains open for anything already underway."
>
  <div class="contact">
    <p class="eyebrow">Service notice</p>
    <h1>We're no longer taking enquiries</h1>
    <p class="lede">
      On <strong>11 November 2026</strong> Balli Balli Seoul stopped arranging
      plumbing, locksmiths, cleaning, Korean lessons, moving and concierge
      errands. Our <strong>KakaoTalk channel and WhatsApp line are closed</strong>,
      and we are not booking, quoting or dispatching anything.
    </p>

    <div class="panel">
      <h2>If you need help right now</h2>
      <ul>
        <li>
          <strong>Locked out, a leak, no hot water</strong> — call your building
          manager (관리사무소) first; they usually have the trade they already use.
          Our <a href="/blog/">guides</a> explain what each job should cost, so
          you can judge a quote even without Korean.
        </li>
        <li>
          <strong>An emergency</strong> — 119 for fire, gas and medical; 112 for
          police. Both take English. See
          <a href="/blog/korea-emergency-numbers-112-119/">the emergency numbers guide</a>.
        </li>
        <li>
          <strong>Tourist or general help in English</strong> — the government
          hotline <a href="/blog/korea-travel-hotline-1330/">1330</a> is free,
          24 hours, and genuinely good.
        </li>
      </ul>
    </div>

    <p class="assure">
      <strong>Had something underway with us?</strong> Email is still read, and
      we will tell you where it stands. For anything else, there is nothing to
      settle — no outstanding bookings and nothing left to pay.
    </p>

    <a href={EMAIL_URL} class="cta-btn email">✉️ {EMAIL_ADDRESS}</a>

    <p class="footnote">
      Everything we learned in two years of doing this is written down in our
      <a href="/blog/">guides to living in Seoul</a> — over a hundred of them,
      still online, still free. <a href="/blog/notice-all-services-ended/">Read the full notice →</a>
    </p>
  </div>
</Base>

<style>
  .contact{max-width:600px;margin:0 auto}
  .eyebrow{font-size:13px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
  h1{font-size:clamp(26px,4.6vw,38px);line-height:1.15;font-weight:800;letter-spacing:-.02em}
  .lede{color:var(--muted);margin:16px 0 30px}
  .lede strong{color:var(--fg)}
  .panel{border:2px solid var(--border);border-radius:var(--radius);padding:22px 24px;margin-bottom:26px}
  .panel h2{font-size:19px;font-weight:800;margin-bottom:14px}
  .panel ul{list-style:none;display:flex;flex-direction:column;gap:14px}
  .panel li{font-size:15px;color:var(--muted);line-height:1.65}
  .panel strong{color:var(--fg)}
  .panel a{color:var(--primary-dark);font-weight:700;text-decoration:underline;text-underline-offset:3px}
  .assure{font-size:15px;color:var(--muted);margin-bottom:18px}
  .assure strong{color:var(--fg)}
  .cta-btn{display:inline-flex;align-items:center;gap:10px;background:var(--email);color:#fff !important;font-weight:800;font-size:16px;padding:14px 28px;border-radius:999px}
  .cta-btn:hover{filter:brightness(1.15)}
  .footnote{margin-top:30px;padding-top:20px;border-top:1px solid var(--border);font-size:14px;color:var(--muted)}
  .footnote a{color:var(--primary-dark);font-weight:700;text-decoration:underline;text-underline-offset:3px}
</style>
