---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import CategoryNav from '../../components/CategoryNav.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Guides for Living in Seoul, in English — Balli Balli Seoul"
  description={`${posts.length} practical guides to living in Seoul, in English: renting and home repairs, transport, food, health, things to do — and what each one costs.`}
>
  <h1>Guides for life in Seoul</h1>
  <p class="lede">
    Practical, no-fluff answers to living here — the things that go wrong at home,
    the systems nobody explains, and the places worth your afternoon. What to try
    yourself, what it costs, and how to get it sorted in English.
  </p>

  <CategoryNav active={null} />

  {posts.length === 0 && <p class="empty">No posts yet — first guides are on the way.</p>}

  <PostGrid posts={posts} />
</Base>

<style>
  h1{font-size:clamp(28px,5vw,42px);font-weight:800;letter-spacing:-.02em}
  .lede{color:var(--muted);margin:14px 0 32px;max-width:560px}
  .empty{color:var(--muted);border:1px dashed var(--border);border-radius:var(--radius);padding:28px;text-align:center}
  @media(min-width:768px){ :global(main.page-main){max-width:980px} }
</style>
