---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Blog — Balli Balli Seoul"
  description="Practical guides for expats and travelers in Seoul: plumbing, locksmiths, cleaning, moving and everyday problems — explained in English."
>
  <h1>Guides for life in Seoul</h1>
  <p class="lede">
    Practical, no-fluff answers to the problems that stop you in Korea — what to try
    yourself, what it costs, and how to get it sorted in English.
  </p>

  {posts.length === 0 && <p class="empty">No posts yet — first guides are on the way.</p>}

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="meta">
              <span class="chip">{post.data.service}</span>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.cover && (
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt ?? ''}
                width={720}
                densities={[1, 2]}
                class="thumb"
              />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  h1{font-size:clamp(28px,5vw,42px);font-weight:800;letter-spacing:-.02em}
  .lede{color:var(--muted);margin:14px 0 40px;max-width:560px}
  .empty{color:var(--muted);border:1px dashed var(--border);border-radius:var(--radius);padding:28px;text-align:center}
  .post-list{list-style:none;display:flex;flex-direction:column;gap:28px}
  .post-card{display:block;border:2px solid var(--border);border-radius:var(--radius);padding:24px;transition:border-color .15s}
  .post-card:hover{border-color:var(--primary)}
  .thumb{margin-top:16px}
  .meta{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted);margin-bottom:8px}
  .chip{background:var(--primary-light);color:var(--primary-dark);border:1px solid #bbf7d0;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:capitalize}
  .post-card h2{font-size:20px;font-weight:800;margin-bottom:6px}
  .post-card p{color:var(--muted);font-size:15px}
</style>
