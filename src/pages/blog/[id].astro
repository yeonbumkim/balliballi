---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { WHATSAPP_URL, KAKAO_URL, SERVICE_PAGES, CATEGORY_LABELS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, service, category, cover, coverAlt, coverCaption } = post.data;

const servicePage = SERVICE_PAGES[service];
const ogImage = cover ? new URL(cover.src, Astro.site).href : undefined;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Seoul' });

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogImage && { image: ogImage }),
  mainEntityOfPage: canonicalURL,
  author: {
    '@type': 'Organization',
    name: 'Balli Balli Seoul',
    url: 'https://balliballi.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Balli Balli Seoul',
    legalName: '지인어스 (Jiinus)',
    logo: { '@type': 'ImageObject', url: 'https://balliballi.com/favicon.svg' },
  },
};
---

<Base title={title} description={description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="post-head">
      <div class="meta">
        <span class="chip">{category ? CATEGORY_LABELS[category] : service}</span>
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span class="updated">Updated {fmt(updatedDate)}</span>}
        <span class="byline">By the <a href="/about/">Balli Balli Seoul team</a></span>
      </div>
      <h1>{title}</h1>
    </header>

    {cover && (
      <figure class="cover-figure">
        <Image src={cover} alt={coverAlt ?? ''} width={960} densities={[1, 2]} class="cover" />
        <figcaption class="cover-caption">
          {coverCaption && <span>{coverCaption}</span>}
          <span class="credit">ⓒ @BalliBalliSeoul</span>
        </figcaption>
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="cta">
      <p>
        <strong>Stuck on the Korean part?</strong> Send us a photo — we'll tell you
        what it is and what it should cost, in English. First answer is free. Or see our
        <a href={servicePage.href}>{servicePage.label}</a>.
      </p>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="cta-btn">💬 WhatsApp Us — in English</a>
      <a href={KAKAO_URL} target="_blank" rel="noopener" class="cta-btn kakao">KakaoTalk Chat</a>
    </aside>

    <aside class="services" aria-labelledby="services-heading">
      <h2 id="services-heading">What we actually do in Seoul</h2>
      <p class="services-lead">
        We're a small team in Seoul that handles the parts of life here that
        happen in Korean — the call, the visit, the price, the paperwork.
      </p>
      <ul class="service-grid">
        <li><a href="/plumbing"><strong>Plumbing</strong><span>Blocked drains, leaks, no hot water</span></a></li>
        <li><a href="/locksmith"><strong>Locksmith</strong><span>Locked out, dead keypad, lock changes</span></a></li>
        <li><a href="/cleaning"><strong>Cleaning</strong><span>Regular, move-in, deep clean, aircon</span></a></li>
        <li><a href="/moving"><strong>Moving</strong><span>Quotes, packing, bulky waste, disposal</span></a></li>
        <li><a href="/etc"><strong>Anything else</strong><span>Errands, calls, translation, forms</span></a></li>
        <li><a href="/korean-lessons"><strong>Korean lessons</strong><span>Conversation, situations, TOPIK — free trial</span></a></li>
        <li><a href="/about/"><strong>Who we are</strong><span>We run coliving houses here</span></a></li>
      </ul>
    </aside>
  </article>
</Base>

<style>
  .post-head{margin-bottom:28px}
  .meta{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted);margin-bottom:12px}
  .chip{background:var(--primary-light);color:var(--primary-dark);border:1px solid #bbf7d0;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:capitalize}
  .updated{font-style:italic}
  .byline a{text-decoration:underline;text-underline-offset:3px}
  .byline a:hover{color:var(--fg)}
  h1{font-size:clamp(26px,4.6vw,40px);line-height:1.15;font-weight:800;letter-spacing:-.02em}
  .cover{max-width:520px;width:100%;height:auto;margin:0 auto;display:block}
  .cover-figure{margin:0 0 32px}
  .cover-caption{display:flex;justify-content:center;gap:10px;margin-top:10px;font-size:12.5px;color:var(--muted)}
  .cover-caption .credit{opacity:.75}
  .cta{background:var(--primary-light);border:2px solid #bbf7d0;border-radius:var(--radius);padding:22px;margin-top:44px;font-size:15px}
  .cta a{color:var(--primary-dark);font-weight:700;text-decoration:underline;text-underline-offset:3px}
  .cta-btn{display:inline-flex;align-items:center;gap:8px;margin-top:14px;background:var(--whatsapp);color:#fff !important;font-weight:800;padding:13px 24px;border-radius:999px;text-decoration:none !important}
  .cta-btn.kakao{background:var(--kakao);color:#191919 !important}
  .cta-btn:hover{filter:brightness(.95)}

  .services{margin-top:40px;padding-top:28px;border-top:1px solid var(--border)}
  .services h2{font-size:19px;font-weight:800;margin:0 0 6px;letter-spacing:-.01em}
  .services-lead{margin:0 0 18px;font-size:14.5px;color:var(--muted)}
  .service-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .service-grid a{display:block;padding:14px 16px;border:1px solid var(--border);border-radius:12px;text-decoration:none;background:var(--bg-soft)}
  .service-grid a:hover{border-color:var(--primary);background:var(--primary-light)}
  .service-grid strong{display:block;font-size:15px;color:var(--text);font-weight:800}
  .service-grid span{display:block;margin-top:3px;font-size:12.5px;color:var(--muted);line-height:1.45}
  @media(max-width:640px){.service-grid{grid-template-columns:1fr}}
</style>

<style is:global>
  .prose h2{font-size:24px;font-weight:800;margin:36px 0 12px;letter-spacing:-.01em}
  .prose h3{font-size:19px;font-weight:700;margin:26px 0 10px}
  .prose p{margin:14px 0}
  .prose ul,.prose ol{margin:14px 0;padding-left:26px}
  .prose li{margin:6px 0}
  .prose blockquote{background:var(--primary-light);border-left:4px solid var(--primary);border-radius:0 12px 12px 0;padding:14px 18px;margin:22px 0;font-size:15px}
  .prose blockquote p{margin:6px 0}
  .prose table{width:100%;border-collapse:collapse;font-size:14px;margin:22px 0}
  .prose th{text-align:left;padding:10px 12px;background:var(--bg-soft);font-weight:700;border-bottom:2px solid var(--border)}
  .prose td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top}
  .prose code{background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;font-size:.9em}
  .prose img{margin:22px auto 0;display:block;max-width:520px;width:100%;height:auto}
  .prose p:has(> img) + p:has(> em:only-child){text-align:center;font-size:12.5px;color:var(--muted);margin:8px 0 22px}
  .prose p:has(> img) + p:has(> em:only-child) > em{font-style:normal}
  /* 이미지와 캡션이 같은 <p>에 합쳐진 경우도 동일 스타일 */
  .prose p:has(> img) > em{display:block;text-align:center;font-style:normal;font-size:12.5px;color:var(--muted);margin-top:8px}
  .prose a{color:var(--primary-dark);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .prose hr{border:none;border-top:1px solid var(--border);margin:32px 0}
</style>
